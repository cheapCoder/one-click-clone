{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "manifest_version": 3,
  "name": "一键 Clone 到本地",
  "version": "0.2.0",
  "description": "在 GitHub/GitLab 仓库页点击图标，调用本机 git 克隆到预设目录并用编辑器打开。",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging", "notifications", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "一键 Clone 到本地"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
